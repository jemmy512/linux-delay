{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build and test Android ARM64 collector",
			"type": "shell",
			"command": "make",
			"args": [
				"test",
				"android"
			],
			"options": {
				"env": {
					"BPF_CLANG": "/opt/homebrew/opt/llvm/bin/clang"
				}
			},
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}